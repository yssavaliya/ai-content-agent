# Example environment settings for ai-content-agent
# Copy this file to .env and update values as needed.

# Logging level for the application. Example values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database file path used by the database layer.
DATABASE_PATH=agent.db

# Command used for OpenCode execution, if applicable.
OPENCODE_COMMAND=opencode

# Enable Instagram-related behavior in future checkpoints.
# Use true/false, yes/no, 1/0.
INSTAGRAM_ENABLED=false

# Image provider identifier for future image generation integrations.
IMAGE_PROVIDER=local
