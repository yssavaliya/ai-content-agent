# Example environment settings for ai-content-agent
# Copy this file to .env and update values as needed.
# NEVER commit real secrets to the repository.

# Logging level for the application. Example values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database file path used by the database layer.
DATABASE_PATH=agent.db

# Command used for OpenCode execution, if applicable.
OPENCODE_COMMAND=opencode

# Timeout (seconds) for each opencode invocation before it is killed.
OPENCODE_TIMEOUT_SECONDS=120

# Master switch for Instagram-related behavior.
# Use true/false, yes/no, 1/0.
INSTAGRAM_ENABLED=false

# Image provider identifier for image generation.
# Options: pollinations (free FLUX images, no key; alias: flux), pillow (offline typographic poster,
# no network), openai (paid), local (writes the prompt only), mock (tests).
IMAGE_PROVIDER=local

# --- OpenAI image provider (IMAGE_PROVIDER=openai) ---
# Optional unless the openai provider is selected. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1
OPENAI_MAX_RETRIES=3
OPENAI_REQUEST_TIMEOUT_SECONDS=60

# --- OpenAI text fallback ---
# When opencode is unavailable, times out, or fails, agents fall back to
# OpenAI chat completions (only if OPENAI_API_KEY is set).
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_TEXT_FALLBACK_ENABLED=true

# --- LLM provider ---
# Which engine runs the agents:
#   opencode (default) - free opencode CLI (see opencode.json); falls back to OpenAI/Gemini
#                        only if their API keys are set
#   openai             - ChatGPT via API (paid), fast; falls back to Gemini, then opencode
#   gemini             - Google Gemini via API (proprietary, free tier not guaranteed); falls back to OpenAI, then opencode
LLM_PROVIDER=opencode

# --- Google Gemini ---
# Used when LLM_PROVIDER=gemini, or as a fallback if OpenAI is unavailable.
# Calls go through Google's OpenAI-compatible endpoint (no extra SDK needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Instagram publishing ---
# Real publishing requires an Instagram Business account linked to a Facebook Page,
# a Meta app with instagram_business_content_publish permission, and Meta App Review.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=21.0
INSTAGRAM_PUBLISH_ENABLED=false

# --- Instagram analytics (needs instagram_business_manage_insights) ---
INSTAGRAM_ANALYTICS_ENABLED=false
# Only posts newer than this many days are re-measured on each run.
ANALYTICS_MAX_AGE_DAYS=30

# --- Buffer (optional publisher + analytics; Buffer is proprietary, its free plan is limited) ---
# When both are set, posts are sent through Buffer instead of the Instagram Graph API.
# Buffer analytics are used whenever BUFFER_ACCESS_TOKEN is set.
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=
# Optional HH:MM in UTC. When set, posts are scheduled for the next occurrence of that time
# (e.g. 12:30 = 6:00 PM IST) instead of being shared the moment the job finishes.
BUFFER_SCHEDULE_TIME_UTC=

# --- Media hosting ---
# Instagram requires a public HTTPS image URL. The default is GitHub raw hosting.
# Options: none, github
MEDIA_HOST=github
MEDIA_HOST_REPO=your-github-user/your-image-repo
MEDIA_HOST_TOKEN=
MEDIA_HOST_BRANCH=main
MEDIA_HOST_PATH=images

# --- Notifications ---
# Comma-separated list of enabled channels: dryrun, discord, telegram, slack
# (dryrun only writes to the log; there is no email channel).
NOTIFY_CHANNELS=dryrun
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- Scientist / learning loop ---
# Minimum posts per arm before an experiment result is considered.
SCIENTIST_MIN_SAMPLE_SIZE=10
# Minimum |Cohen's d| that counts as a meaningful effect.
SCIENTIST_MIN_EFFECT=0.15
# Minimum confidence (0..1) before a recommendation is applied to strategy.md.
SCIENTIST_APPLY_THRESHOLD=0.6
SCIENTIST_MAX_RECOMMENDATIONS=5

# --- Growth engine ---
# Follower milestones: BASE_TARGET, then x MULTIPLIER for every further PERIOD_DAYS (1000, 2500, 6250 ...).
# The clock starts at GROWTH_START_DATE (YYYY-MM-DD) or, if unset, the day of the first follower snapshot.
GROWTH_START_DATE=
GROWTH_BASE_TARGET=1000
GROWTH_MULTIPLIER=2.5
GROWTH_PERIOD_DAYS=90
# A new caption at least this similar (0-1) to an earlier one is regenerated once, then blocked.
DUPLICATE_SIMILARITY_THRESHOLD=0.85
# Estimated cost per 1000 tokens for paid LLM providers (openai/gemini) in the api_usage table; 0 = untracked.
LLM_COST_PER_1K_TOKENS=0

# --- Free-tier LLM provider chain (recommended) ---
# Providers are tried in this order and any without credentials is skipped. The first valid JSON answer wins.
# If every provider fails the pipeline falls back to local templates, so a provider outage never stops a run.
# Leave empty to keep the older single-provider LLM_PROVIDER mode. Names: groq, gemini, cloudflare,
# openrouter, pollinations, openai (paid: not in the default chain), opencode.
LLM_CHAIN=groq,gemini,cloudflare,openrouter,pollinations,opencode
# Groq: free plan, key from console.groq.com. The limits are shown per account in the console.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cloudflare Workers AI: 10,000 neurons/day free. Account id + an API token with Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# OpenRouter: only the ":free" models are free (about 20 requests/min, 50/day without purchased credits).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Pollinations text: works without a key on the legacy endpoint but only ~1 reply per 45 s per IP.
POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
POLLINATIONS_TEXT_MODEL=openai-fast
POLLINATIONS_API_KEY=
# Per-request timeout, total time per call across providers, tries per provider, retry backoff.
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_CALL_BUDGET_SECONDS=240
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_SECONDS=1.5
# Reasoning models count hidden thinking against this; too low truncates the JSON.
LLM_MAX_OUTPUT_TOKENS=8192
# Validated answers are cached so re-running a failed job the same day costs no quota.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_HOURS=24
LLM_CACHE_DIR=cache/llm

# --- Images ---
# IMAGE_PROVIDER=auto tries IMAGE_CHAIN in order: Cloudflare FLUX.1 schnell (no watermark, uses the Cloudflare
# credentials above, inside the free daily allowance), then Pollinations FLUX (keyless, but it stamps its logo
# and is rate limited), then the offline Pillow poster, which cannot fail.
IMAGE_CHAIN=cloudflare,pollinations,pillow
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Buffer's free plan allows 10 scheduled posts. When that many are already waiting the run stops before
# generating anything. Set 0 to disable the check.
BUFFER_QUEUE_LIMIT=10
